# Copy required placeholders into your existing .env; never overwrite real credentials.
APP_ID=
APP_SECRET=
# Local RWKV does not require Cloudflare Access credentials.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

LISTEN_ADDR=127.0.0.1:8653
# Model selects context budget; the API endpoint is configured separately.
RWKV_MODEL=rwkv-1.5b
# Full raw batch endpoint of the local RWKV service.
RWKV_API_URL=http://127.0.0.1:8000/v1/batch/completions
RWKV_MAX_TOKENS=2048
RWKV_TEMPERATURE=1.0
RWKV_TOP_K=50
RWKV_TOP_P=0.3
RWKV_ALPHA_PRESENCE=1.0
RWKV_ALPHA_FREQUENCY=0.1
RWKV_ALPHA_DECAY=0.99
RWKV_CHUNK_SIZE=1
RWKV_TIMEOUT=90s
WORKERS=4
QUEUE_PER_WORKER=16
SESSION_LIMIT=1000
SESSION_TTL=24h
QQ_REPLY_RUNES=1500
