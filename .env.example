# Copy required placeholders into your existing .env; never overwrite real credentials.
APP_ID=
APP_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

LISTEN_ADDR=127.0.0.1:8080
# Built-in routing: rwkv-1.5b / rwkv-3b / rwkv-7b / rwkv-13b
RWKV_MODEL=rwkv-1.5b
# Optional full raw batch endpoint. Empty uses the model's blog origin.
RWKV_API_URL=
RWKV_MAX_TOKENS=2048
RWKV_TEMPERATURE=1.0
RWKV_TOP_K=50
RWKV_TOP_P=0.3
RWKV_ALPHA_PRESENCE=1.0
RWKV_ALPHA_FREQUENCY=0.1
RWKV_ALPHA_DECAY=0.99
RWKV_CHUNK_SIZE=1
RWKV_TIMEOUT=90s
WORKERS=4
QUEUE_PER_WORKER=16
SESSION_LIMIT=1000
SESSION_TTL=24h
QQ_REPLY_RUNES=1500
